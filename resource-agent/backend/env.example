# Copy this file to `.env` and fill in real values.
# Tokens can be short-lived — just regenerate when they expire.

# GitHub — optional for now (works unauthenticated at a lower rate limit)
GITHUB_TOKEN=

# Hugging Face — optional for now (works unauthenticated for public datasets)
HF_TOKEN=

# Web search provider — leave blank until Stage 4; connector is stubbed until then
BRAVE_SEARCH_API_KEY=

# LLM key — used only for requirement parsing / ranking explanations
OPENAI_API_KEY=
